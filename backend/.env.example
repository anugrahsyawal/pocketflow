NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://pocketflow:pocketflow_dev_secret@127.0.0.1:5432/pocketflow
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret

# Production: explicit HTTPS CORS_ORIGIN; random SESSION_SECRET >=32 bytes.
# Placeholders above are development-only. Hosting setup and actual provider TLS
# verification are still required; this file is not production-ready.
# /health = process liveness; /ready = bounded database connectivity (200/503).

# DB_CONNECTION_MODE defaults to direct. Use transaction only with the matching
# pooler URL (1 application connection, no prepared statements or pipelining).
# Migrations require direct or session plus the matching direct/session URL.
# DB_CONNECTION_MODE=direct
# DB_SSL_MODE defaults to inherit locally, verify-full in production.
# Production cannot opt out of verify-full. DB_SSL_CA optionally contains the
# trusted PEM certificate when the provider CA is not in the runtime trust store.
# Do not use sslrootcert paths in DATABASE_URL; this driver does not load them.

# Single Owner Provisioning (CLI)
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=PocketFlow Owner
OWNER_PASSWORD=replace-with-a-long-random-password
